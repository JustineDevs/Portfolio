# Auth.js session secret.
# Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Google OAuth credentials for the primary admin sign-in flow.
# Create a Web application credential in Google Cloud Console and add:
#   http://localhost:3000/api/auth/callback/google
#   https://your-domain.example/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Single admin email used for CMS login.
# Use the exact email address you want to allow into /admin.
ADMIN_EMAIL=example@email.com

# Turso/libSQL database URL.
# Get this from your Turso database dashboard or `turso db show <db-name>`.
# Example: libsql://your-db-name-your-org.turso.io
TURSO_DATABASE_URL=

# Turso auth token.
# Create it from the Turso dashboard or CLI, then paste it here.
TURSO_AUTH_TOKEN=

# GitHub personal access token used only for reading contribution activity.
# Create a read-only token in GitHub Settings -> Developer settings -> Personal access tokens.
# Use the smallest scope that supports the contribution data you want to show.
GH_TOKEN=

# GitHub username whose activity map should be displayed.
# Example: JustineDevs
GITHUB_USERNAME=

# Optional. Public uptime / status page URL for the top bar link (Instatus, Better Stack, etc.).
# If unset, the UI falls back to Vercel platform status (https://www.vercel-status.com/).
NEXT_PUBLIC_STATUS_PAGE_URL=
