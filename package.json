{
  "name": "portfolio",
  "version": "0.1.2",
  "description": "Portfolio website project",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "dev:turbo": "node ./node_modules/next/dist/bin/next dev --turbo",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/next/dist/bin/next lint",
    "ci:check": "node scripts/ci-check.mjs",
    "ci:push": "node scripts/ci-push.mjs",
    "git:hooks": "git config core.hooksPath githooks",
    "act:ci": "act -W .github/workflows/ci.yml -j quality",
    "test": "node --import tsx test/admin-users.integration.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:status": "node scripts/db/status.cjs",
    "db:apply-google-schema": "node scripts/db/apply-google-schema.cjs",
    "db:repair-email-hash": "node scripts/db/repair-email-hash.cjs",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node -e \"const jiti=require('jiti')(process.cwd()); Promise.resolve(jiti('./db/seed.ts')).then((m)=>m.seedInitialContent()).catch((err)=>{console.error(err); process.exit(1);})\"",
    "commit": "node version/scripts/parallel-commit.js",
    "commit:dry": "node version/scripts/parallel-commit.js --dry-run",
    "commit:sh": "bash version/scripts/parallel-commit.sh",
    "commit:sh:dry": "bash version/scripts/parallel-commit.sh --dry-run",
    "commit:all": "git add -A && git commit -m \"chore: update all changes\"",
    "commit:auto": "bash version/scripts/parallel-commit.sh --max 3",
    "status": "git status",
    "changes": "git status --porcelain",
    "staged": "git diff --cached --name-only",
    "release:git-tag": "node version/scripts/git-tag-from-package.js"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@lobehub/fluent-emoji": "^4.1.0",
    "@lobehub/icons": "^4.0.3",
    "@lobehub/icons-static-svg": "^1.77.0",
    "@lobehub/ui": "^4.21.3",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "antd": "^6.2.0",
    "antd-style": "^4.1.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.2",
    "framer-motion": "^11.0.0",
    "geist": "^1.5.1",
    "gsap": "^3.14.2",
    "lenis": "^1.3.17",
    "lucide-react": "^0.344.0",
    "next": "^14.2.0",
    "next-auth": "^5.0.0-beta.22",
    "react": "^18.3.0",
    "react-calendly": "^4.4.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-github-alerts": "^2.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/gsap": "^1.20.2",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.5",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  },
  "optionalDependencies": {
    "@libsql/win32-x64-msvc": "0.5.29"
  },
  "keywords": [
    "portfolio",
    "website"
  ],
  "author": "JustineDevs",
  "license": "GPL-3.0"
}
