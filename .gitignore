# See https://help.github.com/articles/ignoring-files/

# --- Dependencies ---
/node_modules
/.pnp
.pnp.js

# --- Environment & secrets (never commit) ---
.env
.env.*
!.env.example
!.env*.example
.dev.vars*
!.dev.vars.example
*.pem
*.key
*.p12
*.pfx
*credentials*.json
serviceAccount*.json

# --- Next.js & build output ---
/.next/
/out/
/build
dist/
.vercel
*.tsbuildinfo

# --- Caches & tooling ---
.cache
.turbo
.swc
.parcel-cache
.eslintcache
node_modules/.cache

# --- Test & coverage ---
/coverage
.nyc_output
test-results/
playwright-report/
blob-report/
.pnpm-store/
Screenshot *.png

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Debug / local tooling ---
.orchids

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Windows system (watchers / indexing) ---
DumpStack.log.tmp
hiberfil.sys
pagefile.sys
swapfile.sys

# --- IDE / editor ---
.vscode
.idea
*.swp
*.swo
*~
*.orig
*.rej

# --- Local databases (Turso remote is via env; file DB stays local) ---
/db/local.db
/db/local.db-*
*.sqlite
*.sqlite3

# --- Local AI-usage sources and generated exports (never commit) ---
/.codex/
/.config/orca/
/.omx/
/public/usage/
**/ai-usage*.csv
**/usage-export*.csv
**/private-usage*/
.vercel
.internal
